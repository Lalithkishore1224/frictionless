# ---- Database ----
# PostgreSQL connection string (a Postgres instance is required).
# For zero-friction local dev, start one with Docker:
#   docker run --name servelless-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servelless?schema=public"

# ---- Session (signing key for the auth JWT cookie) ----
# Generate with:  openssl rand -base64 48
SESSION_SECRET="change-me-to-a-random-64-byte-secret"

# ---- Admin access ----
# Comma separated emails that are treated as platform admins.
ADMIN_EMAILS="admin@servelless.app"

# ---- User OAuth: Google login ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dev-only: enable email-based sign-in (no OAuth credentials needed).
# Always keep disabled (or unset) in production.
DEV_LOGIN="true"
NEXT_PUBLIC_DEV_LOGIN="true"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_CLIENT_ID=""

# ---- User OAuth: GitHub login ----
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Engine OAuth: Fly.io (Machine API) ----
FLY_OAUTH_CLIENT_ID=""
FLY_OAUTH_CLIENT_SECRET=""
# Default org slug used when creating app namespaces, e.g. "personal"
FLY_ORG="personal"

# ---- Engine OAuth: GitHub (Codespaces / repo tooling) ----
GITHUB_ENGINE_CLIENT_ID=""
GITHUB_ENGINE_CLIENT_SECRET=""

# ---- Encryption key for AES-256-GCM token encryption ----
# Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="change-me-to-a-32-byte-encryption-key"
