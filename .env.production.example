# =============================================================
# Servelless — PRODUCTION environment template (Vercel + Neon)
# Copy this into your Vercel project settings (Settings -> Environment Variables)
# =============================================================

# --- Database (Neon free tier) ---
# In Neon: create a project, copy the connection string that includes
# ?sslmode=require at the end. Uses "main" database. Example:
DATABASE_URL="postgresql://neondb_owner:xxxxx@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Session signing key (JWT HS256) ---
# Generate one:  openssl rand -base64 48
SESSION_SECRET="PASTE_64_BYTE_BASE64_HERE"

# --- Encryption key for AES-256-GCM token encryption ---
# Generate one:  openssl rand -base64 32
ENCRYPTION_KEY="PASTE_32_BYTE_BASE64_HERE"

# --- Admin emails (comma separated) ---
ADMIN_EMAILS="you@gmail.com"

# --- Public base URL = your Vercel deployment URL ---
# Use your .vercel.app URL (can change, see runbook step for updating OAuth redirects)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# ---- User login: Google OAuth ----
GOOGLE_CLIENT_ID="PASTE_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="PASTE_GOOGLE_CLIENT_SECRET"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="PASTE_GOOGLE_CLIENT_ID"

# ---- User login: GitHub OAuth ----
GITHUB_CLIENT_ID="PASTE_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="PASTE_GITHUB_CLIENT_SECRET"
NEXT_PUBLIC_GITHUB_CLIENT_ID="PASTE_GITHUB_CLIENT_ID"

# ---- Engine OAuth: GitHub (Codespaces) ----
GITHUB_ENGINE_CLIENT_ID="PASTE_GITHUB_ENGINE_CLIENT_ID"
GITHUB_ENGINE_CLIENT_SECRET="PASTE_GITHUB_ENGINE_CLIENT_SECRET"

# ---- Engine OAuth: Fly.io (optional on serverless, mostly unusable) ----
FLY_OAUTH_CLIENT_ID=""
FLY_OAUTH_CLIENT_SECRET=""
FLY_ORG="personal"

# ---- Dev login: ALWAYS off in production (do NOT set to true) ----
DEV_LOGIN="false"
NEXT_PUBLIC_DEV_LOGIN="false"
